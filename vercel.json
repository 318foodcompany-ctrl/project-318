{
  "rewrites": [
    { "source": "/api/admin-marketing-assistant", "destination": "/api/admin-marketing?route=assistant" },
    { "source": "/api/admin-marketing-autopilot-action", "destination": "/api/admin-marketing?route=autopilot-action" },
    { "source": "/api/admin-marketing-autopilot-bulk", "destination": "/api/admin-marketing?route=autopilot-bulk" },
    { "source": "/api/admin-marketing-autopilot-executive", "destination": "/api/admin-marketing?route=autopilot-executive" },
    { "source": "/api/admin-marketing-autopilot-learning", "destination": "/api/admin-marketing?route=autopilot-learning" },
    { "source": "/api/admin-marketing-autopilot-publish", "destination": "/api/admin-marketing?route=autopilot-publish" },
    { "source": "/api/admin-marketing-autopilot-queue", "destination": "/api/admin-marketing?route=autopilot-queue" },
    { "source": "/api/admin-marketing-content", "destination": "/api/admin-marketing?route=content" },
    { "source": "/api/admin-marketing-test-email", "destination": "/api/admin-marketing?route=test-email" },
    { "source": "/sitemap.xml", "destination": "/api/public-content?route=sitemap" },
    { "source": "/blog", "destination": "/api/public-content?route=blog-index" },
    { "source": "/blog/:slug", "destination": "/api/public-content?route=blog-post&slug=:slug" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.googletagmanager.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co https://www.facebook.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://www.google-analytics.com https://region1.google-analytics.com https://www.facebook.com; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'self'; upgrade-insecure-requests" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*).(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
